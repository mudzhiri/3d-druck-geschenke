{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "3d-druck-geschenke.de" }],
      "destination": "https://www.3d-druck-geschenke.de/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "personalisierte-3d-geschenke.de" }],
      "destination": "https://www.3d-druck-geschenke.de/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.personalisierte-3d-geschenke.de" }],
      "destination": "https://www.3d-druck-geschenke.de/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-blog",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/daily-products",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/indexnow",
      "schedule": "0 11 * * *"
    }
  ]
}
